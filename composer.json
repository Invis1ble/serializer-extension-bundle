{
    "name": "invis1ble/serializer-extension-bundle",
    "type": "symfony-bundle",
    "description": "Symfony Bundle for symfony/serializer extension.",
    "authors": [
        {
            "name": "Invis1ble",
            "email": "Invis1ble@users.noreply.github.com"
        }
    ],
    "keywords": [
        "serializer",
        "deserializer",
        "normalizer",
        "denormalizer",
        "uri",
        "url",
        "uriinterface",
        "psr",
        "extension",
        "symfony-bundle"
    ],
    "require": {
        "php": ">=8.1",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "invis1ble/symfony-serializer-extension": "^1.2",
        "guzzlehttp/guzzle": "^7.3"
    },
    "require-dev": {
        "escapestudios/symfony2-coding-standard": "^3.18",
        "friendsofphp/php-cs-fixer": "^3.95",
        "matthiasnoback/symfony-dependency-injection-test": "^6.2",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.0",
        "rector/rector": "^2.6",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/property-access": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Invis1ble\\SerializerExtensionBundle\\": "src/",
            "Invis1ble\\SerializerExtensionBundle\\Tests\\": "tests/"
        },
        "exclude-from-classmap": ["/tests/"]
    },
    "license": "MIT"
}
